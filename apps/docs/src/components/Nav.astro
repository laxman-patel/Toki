---
const links = [
  { href: "https://github.com/laxman-patel/Toki", label: "github" },
  { href: "#features", label: "features" },
  { href: "#how-it-works", label: "how it works" },
  { href: "#get-started", label: "get started" },
];
---

<nav class="sticky top-0 z-50 border-b border-[var(--color-border)] bg-[var(--color-bg)]/90 backdrop-blur-sm">
  <div class="mx-auto flex h-12 max-w-5xl items-center justify-between px-6">
    <a href="/" class="text-sm font-semibold tracking-tight">toki</a>
    <div class="flex items-center gap-5">
      {links.map((link) => (
        <a
          href={link.href}
          class="text-xs text-[var(--color-text-muted)] transition-colors hover:text-[var(--color-text)]"
          target={link.href.startsWith("http") ? "_blank" : undefined}
          rel={link.href.startsWith("http") ? "noopener noreferrer" : undefined}
        >
          {link.label}
        </a>
      ))}
    </div>
  </div>
</nav>
