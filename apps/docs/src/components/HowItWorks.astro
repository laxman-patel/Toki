---
const steps = [
  {
    num: "01",
    title: "store secrets",
    desc: "human or trusted agent stores API keys via dashboard, CLI, or MCP. AES-256-GCM encrypted at rest.",
  },
  {
    num: "02",
    title: "issue agent tokens",
    desc: "create agents, get scoped tok_ tokens. agents authenticate with these — never with real credentials.",
  },
  {
    num: "03",
    title: "agent makes API calls",
    desc: "using SDK, CLI, or MCP, the agent calls APIs normally. requests route through the toki proxy.",
  },
  {
    num: "04",
    title: "proxy injects credentials",
    desc: "proxy matches target host, decrypts secret, injects real header, forwards upstream. agent never sees it.",
  },
];
---

<section id="how-it-works" class="border-t border-[var(--color-border)] bg-[var(--color-bg-alt)]">
  <div class="mx-auto max-w-5xl px-6 py-20">
    <p class="mb-2 text-xs text-[var(--color-text-muted)]">// how it works</p>
    <h2 class="text-xl font-bold tracking-tight sm:text-2xl">four steps. zero exposure.</h2>

    <div class="mt-12 grid gap-px bg-[var(--color-border)] sm:grid-cols-2">
      {steps.map((s) => (
        <div class="bg-[var(--color-bg-alt)] p-6">
          <span class="text-xs text-[var(--color-text-muted)]">{s.num}</span>
          <h3 class="mt-2 text-sm font-semibold">{s.title}</h3>
          <p class="mt-2 text-xs leading-relaxed text-[var(--color-text-muted)]">{s.desc}</p>
        </div>
      ))}
    </div>

    <div class="mt-8 border border-[var(--color-border)] bg-[var(--color-surface)] p-6 text-xs">
      <p class="mb-4 text-[var(--color-text-muted)]">// architecture</p>
      <div class="leading-relaxed text-[var(--color-text-muted)]">
        <p class="text-[var(--color-text)]">agent (SDK/CLI/MCP)</p>
        <p>&nbsp; | fetch("https://api.anthropic.com/v1/messages")</p>
        <p>&nbsp; | rewrites -&gt; http://localhost:4080/proxy/api.anthropic.com/v1/messages</p>
        <p>&nbsp; | adds Proxy-Authorization: Basic(x:tok_xxx)</p>
        <p>&nbsp; v</p>
        <p class="text-[var(--color-text)]">toki proxy (:4080)</p>
        <p>&nbsp; -&gt; token lookup -&gt; user -&gt; secrets (host match) -&gt; decrypt -&gt; inject header</p>
        <p>&nbsp; v</p>
        <p class="text-[var(--color-text)]">upstream API (with real credentials)</p>
      </div>
    </div>
  </div>
</section>
