---
---

<section id="get-started" class="border-t border-[var(--color-border)]">
  <div class="mx-auto max-w-5xl px-6 py-20">
    <p class="mb-2 text-xs text-[var(--color-text-muted)]">// get started</p>
    <h2 class="text-xl font-bold tracking-tight sm:text-2xl">up and running in minutes.</h2>

    <div class="mt-10 space-y-6">
      <div class="border border-[var(--color-border)] bg-[var(--color-surface)] p-5 text-xs">
        <p class="mb-1 text-[var(--color-text-muted)]"># clone and install</p>
        <p><span class="text-[var(--color-text-muted)]">$</span> git clone https://github.com/laxman-patel/Toki.git</p>
        <p><span class="text-[var(--color-text-muted)]">$</span> cd toki && bun install</p>
        <p>&nbsp;</p>
        <p class="mb-1 text-[var(--color-text-muted)]"># configure</p>
        <p><span class="text-[var(--color-text-muted)]">$</span> cp .env.example .env</p>
        <p><span class="text-[var(--color-text-muted)]">$</span> bun run db:push</p>
        <p>&nbsp;</p>
        <p class="mb-1 text-[var(--color-text-muted)]"># start</p>
        <p><span class="text-[var(--color-text-muted)]">$</span> bun run --filter web dev &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<span class="text-[var(--color-text-muted)]"># dashboard :3000</span></p>
        <p><span class="text-[var(--color-text-muted)]">$</span> bun run --filter @toki/proxy dev <span class="text-[var(--color-text-muted)]"># proxy :4080</span></p>
      </div>

      <div class="grid gap-px bg-[var(--color-border)] sm:grid-cols-3">
        <div class="bg-[var(--color-bg)] p-5">
          <p class="text-[10px] text-[var(--color-text-muted)]">[sdk]</p>
          <div class="mt-3 text-xs leading-relaxed text-[var(--color-text-muted)]">
            <p><span class="text-[#86efac]">import</span> {'{'} createTokiProxy {'}'}</p>
            <p>&nbsp; <span class="text-[#86efac]">from</span> <span class="text-[#fde68a]">"@toki/sdk"</span></p>
            <p class="mt-1"><span class="text-[#86efac]">const</span> fetch = <span class="text-[#93c5fd]">createTokiProxy</span>({'{'}...{'}'})</p>
            <p><span class="text-[#86efac]">await</span> <span class="text-[#93c5fd]">fetch</span>(url, opts)</p>
          </div>
        </div>
        <div class="bg-[var(--color-bg)] p-5">
          <p class="text-[10px] text-[var(--color-text-muted)]">[cli]</p>
          <div class="mt-3 text-xs leading-relaxed text-[var(--color-text-muted)]">
            <p>$ toki login</p>
            <p>$ toki agent create bot</p>
            <p>$ toki secret create \</p>
            <p>&nbsp; --name key --host *.api.com</p>
            <p>$ toki fetch https://...</p>
          </div>
        </div>
        <div class="bg-[var(--color-bg)] p-5">
          <p class="text-[10px] text-[var(--color-text-muted)]">[mcp]</p>
          <div class="mt-3 text-xs leading-relaxed text-[var(--color-text-muted)]">
            <p>toki_agent_create</p>
            <p>toki_secret_create</p>
            <p>toki_fetch</p>
            <p>toki_audit_list</p>
            <p>toki_proxy_status</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
