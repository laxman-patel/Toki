---
---

<section id="get-started" class="border-t border-[var(--color-border)] bg-[var(--color-bg-alt)]">
  <div class="mx-auto max-w-5xl px-6 py-20">
    <p class="mb-2 text-sm font-medium text-[var(--color-text-muted)]">Get started</p>
    <h2 class="text-2xl font-bold tracking-tight sm:text-3xl">Up and running in minutes.</h2>

    <div class="mt-10 space-y-6">
      <div class="rounded-xl border border-[var(--color-border)] bg-[#1c1917] p-5 font-mono text-sm text-[#e7e5e4]">
        <p class="mb-1 text-xs text-[#a8a29e]"># clone and install</p>
        <p><span class="text-[#a8a29e]">$</span> git clone https://github.com/laxman-patel/Toki.git</p>
        <p><span class="text-[#a8a29e]">$</span> cd toki && bun install</p>
        <p>&nbsp;</p>
        <p class="mb-1 text-xs text-[#a8a29e]"># configure</p>
        <p><span class="text-[#a8a29e]">$</span> cp .env.example .env</p>
        <p><span class="text-[#a8a29e]">$</span> bun run db:push</p>
        <p>&nbsp;</p>
        <p class="mb-1 text-xs text-[#a8a29e]"># start</p>
        <p><span class="text-[#a8a29e]">$</span> bun run --filter web dev        <span class="text-[#a8a29e]"># dashboard :3000</span></p>
        <p><span class="text-[#a8a29e]">$</span> bun run --filter @toki/proxy dev <span class="text-[#a8a29e]"># proxy :4080</span></p>
      </div>

      <div class="grid gap-6 sm:grid-cols-3">
        <div class="rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] p-5">
          <p class="text-xs font-medium text-[var(--color-text-muted)]">SDK</p>
          <div class="mt-3 font-mono text-xs leading-relaxed text-[var(--color-text-muted)]">
            <p>import {'{'} createTokiProxy {'}'}</p>
            <p>&nbsp; from "@toki/sdk"</p>
            <p class="mt-1">const fetch = createTokiProxy({'{'}...{'}'})</p>
            <p>await fetch(url, opts)</p>
          </div>
        </div>
        <div class="rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] p-5">
          <p class="text-xs font-medium text-[var(--color-text-muted)]">CLI</p>
          <div class="mt-3 font-mono text-xs leading-relaxed text-[var(--color-text-muted)]">
            <p>$ toki login</p>
            <p>$ toki agent create bot</p>
            <p>$ toki secret create \</p>
            <p>&nbsp; --name key --host *.api.com</p>
            <p>$ toki fetch https://...</p>
          </div>
        </div>
        <div class="rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] p-5">
          <p class="text-xs font-medium text-[var(--color-text-muted)]">MCP</p>
          <div class="mt-3 font-mono text-xs leading-relaxed text-[var(--color-text-muted)]">
            <p>toki_agent_create</p>
            <p>toki_secret_create</p>
            <p>toki_fetch</p>
            <p>toki_audit_list</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
